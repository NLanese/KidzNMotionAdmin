{
    "version": 2,
    "redirects": [
        {
            "source": "/choose-your-products/all-products",
            "destination": "/products/shop/all",
            "permanent": true
        }
    ],
    "build": {
        "env": {
            "NODE_OPTIONS": "--openssl-legacy-provider"
        }
    },
    "crons": [
        {
            "path": "/api/cron/missed-assignments",
            "schedule": "0 13 * * *"
        }
    ]
}
